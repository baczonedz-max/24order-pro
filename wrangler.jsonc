{
  // Cloudflare Worker config. Static files in ./public are served directly;
  // everything under /api/* goes to src/worker.js.
  "name": "24order-pro",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public base of the 24order AI Agent API (menu: no auth needed).
    "ORDER_API_BASE": "https://server.24order.com/api/v1/ai-agent",
    "MAIN_API_BASE": "https://main-server.24order.com/api/v1"
  }
  // Secrets (never commit them). Set them once with:
  //   npx wrangler secret put STATS_API_KEY
  //   npx wrangler secret put AI_AGENT_KEY
  //   npx wrangler secret put GEMINI_API_KEY
}
