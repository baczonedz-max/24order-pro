{
  // Cloudflare Worker config.
  // Build: `npm run build` (Vite builds the dashboard into ./dist).
  // /api/* goes to src/worker.js; everything else is served from ./dist.
  "name": "24order-pro",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The dashboard's own database. Create it once in Cloudflare (Storage & Databases → D1 →
  // Create, name "24order-pro-db") and put its id below. Tables are created automatically.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "24order-pro-db",
      "database_id": "af4a18de-30af-491c-98e9-ecb8a9ab64a7"
    }
  ],
  "vars": {
    "ORDER_API_BASE": "https://server.24order.com/api/v1/ai-agent",
    "MAIN_API_BASE": "https://main-server.24order.com/api/v1"
  }
  // Secrets (never commit them): STATS_API_KEY, AI_AGENT_KEY, GEMINI_API_KEY
}
